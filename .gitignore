# ============================================================
# AeroPool — .gitignore (PUBLIC REPOSITORY)
# ============================================================

# ---- Environment & Secrets ----
.env
.env.*
!.env.example
!.env.staging.example

# ---- Dependencies ----
node_modules/

# ---- Build Output ----
dist/
build/
coverage/

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- OS ----
.DS_Store
Thumbs.db
Desktop.ini

# ---- IDE / Editor ----
.idea/
.vscode/
*.swp
*.swo
*~

# ---- Local KYC Document Vault (PRIVATE USER DATA) ----
server/storage/

# ---- Supabase CLI Local State ----
supabase/.temp/
supabase/.branches/

# ---- Local Runtime Data ----
server/kyc_registry.json
scratch/

# ---- Test Artifacts & Screenshots ----
*.png
!public/*.png
!public/*.jpg

# ---- Temporary Scratch & Debug Files ----
*.tsbuildinfo
