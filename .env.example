# ==============================================================================
# AeroPool — Environment Configuration Matrix (.env.example)
# Target Launch Market: Chhatrapati Shivaji Maharaj International Airport (CSMIA BOM)
# ==============================================================================
#
# IMPORTANT SECURITY GUIDANCE:
# 1. Variables prefixed with 'VITE_' are bundled by Vite into the client application.
#    NEVER place private keys, database passwords, or webhook secrets in 'VITE_' variables!
# 2. Server-only secrets MUST ONLY be accessed from backend services or edge functions.
# 3. For local development without cloud services, leave VITE_APP_MODE="development".
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OPERATING MODE & APP URL
# ------------------------------------------------------------------------------
# Operating Modes:
# - 'development': Offline testing, sample data, simulated radar & demo GPS.
# - 'sandbox':     Payment test gateway (rzp_test_*), test orders, tagged ledger.
# - 'production':  Requires verified PostgreSQL database & live merchant keys.
#                  Critical booking operations fail safely if DB is unreachable.
VITE_APP_MODE="development"
VITE_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
PORT=3000

# ------------------------------------------------------------------------------
# 2. PUBLIC FRONTEND CONFIGURATION (SAFE FOR BROWSER BUNDLE)
# ------------------------------------------------------------------------------
# Supabase PostgreSQL API Endpoint & Public Anonymous Key
# Required for live database synchronization in sandbox & production modes.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-jwt-token"

# Razorpay Client Key ID (Public Identifier)
# In development/sandbox: Use test key starting with 'rzp_test_'
# In production:          Use verified live merchant key starting with 'rzp_live_'
VITE_RAZORPAY_KEY_ID="rzp_test_YourTestKeyId12345"

# Map Tiles & GIS Vector Tile Provider
# Uses OpenStreetMap open raster/vector tile endpoint by default.
VITE_MAP_TILES_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"

# Flight Telemetry Provider Mode ('csmia_live' | 'flightradar24' | 'aviationstack' | 'csmia_schedule')
VITE_FLIGHT_API_PROVIDER="csmia_schedule"

# ------------------------------------------------------------------------------
# 3. SERVER-ONLY SECRETS (NEVER EXPOSE TO BROWSER / CLIENT CODE)
# ------------------------------------------------------------------------------
# Supabase Service-Role Admin Key (Full Row-Level Security Bypass)
# WARNING: Keep private! Used only by backend cron workers and admin endpoints.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key"

# Direct PostgreSQL Database Connection String
# Used for backend database migrations (supabase db push) and pooling engines.
DATABASE_URL="postgresql://postgres:YourSecurePassword@db.your-project-id.supabase.co:5432/postgres"

# Razorpay Merchant Key Secret
# Used exclusively by backend order creation and signature verification.
RAZORPAY_KEY_SECRET="YourRazorpayMerchantSecretKey"

# Razorpay Webhook HMAC-SHA256 Secret
# Used to cryptographically authenticate incoming payment webhook event payloads.
RAZORPAY_WEBHOOK_SECRET="YourRazorpayWebhookSecretKey"

# External Live Flight Radar API Key (FlightRadar24 / AviationStack)
# When provided, activates live ADS-B radar tracking for Mumbai CSMIA BOM airspace.
# When omitted, platform smoothly uses published CSMIA timetable schedules.
FLIGHT_API_KEY=""

# ------------------------------------------------------------------------------
# 4. REQUIRED PRODUCTION INTEGRATIONS CHECKLIST
# ------------------------------------------------------------------------------
# When deploying to production (VITE_APP_MODE="production"), the following are MANDATORY:
# [x] VITE_SUPABASE_URL (Active Supabase project with 20261016 migrations applied)
# [x] VITE_SUPABASE_ANON_KEY (Valid anon JWT)
# [x] DATABASE_URL (Direct PostgreSQL connection for backend migrations)
# [x] VITE_RAZORPAY_KEY_ID (Must start with 'rzp_live_')
# [x] RAZORPAY_KEY_SECRET (Live merchant secret)
# [x] RAZORPAY_WEBHOOK_SECRET (Configured in Razorpay Webhooks dashboard)
#
# ------------------------------------------------------------------------------
# 5. OPTIONAL ENHANCEMENT INTEGRATIONS
# ------------------------------------------------------------------------------
# External SMS Gateway (Twilio / Gupshup / MSG91) for OTP SMS dispatch:
SMS_GATEWAY_API_KEY=""
SMS_GATEWAY_SENDER_ID="AEROPOOL"

# External Push Notification Service (Firebase Cloud Messaging / OneSignal):
VITE_FIREBASE_VAPID_KEY=""
FIREBASE_SERVER_KEY=""

# ------------------------------------------------------------------------------
# 6. STAGING-ONLY TEMPORARY AUTHENTICATION CONFIGURATION
# ------------------------------------------------------------------------------
# In staging/sandbox environments, set to "true" to defer email verification during testing.
# IN PRODUCTION: Mandatory email verification is ALWAYS enforced (fails closed).
VITE_STAGING_SKIP_EMAIL_VERIFICATION="false"
STAGING_SKIP_EMAIL_VERIFICATION="false"

# ------------------------------------------------------------------------------
# 7. DRIVER KYC STORAGE & CAPABILITY TOKEN CONFIGURATION
# ------------------------------------------------------------------------------
# Storage Provider: 'local' (sandbox disk storage) | 'supabase' (Supabase private storage bucket)
# In development & sandbox: defaults to 'local' for zero-dependency offline resilience.
# In staging & production: set to 'supabase' to persist documents to private cloud vault.
AEROPOOL_KYC_STORAGE_PROVIDER="local"
SUPABASE_KYC_BUCKET="kyc-vault"

# Cryptographically strong HMAC secret for short-lived document capability preview tokens (Min 32 chars)
# Mandatory in production. (In sandbox, defaults to a cryptographically generated session secret).
KYC_TOKEN_SECRET="aeropool_kyc_super_secure_vault_token_signing_secret_2026"
