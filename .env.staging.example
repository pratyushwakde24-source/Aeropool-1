# ==============================================================================
# AeroPool — Staging Environment Template (.env.staging.example)
# Target Project: aeropool-staging (Reference: rkuzkwggijthbqwlwnps)
# Region: ap-southeast-1 (Singapore)
# ==============================================================================
#
# IMPORTANT SAFETY & CONFIGURATION GUIDELINES:
# 1. This template is configured exclusively for the ISOLATED STAGING project.
#    DO NOT insert credentials for production project 'krxkxhieyqcytknixqdm' here!
# 2. Variables prefixed with 'VITE_' are bundled into client JavaScript.
#    NEVER place database passwords, service-role keys, or secrets in 'VITE_' variables!
# 3. For staging validation, operating mode MUST be 'sandbox'.
# 4. Copy this file to '.env.staging' (or '.env' when actively testing staging locally).
#    NEVER commit your active '.env' or '.env.staging' with real credentials to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OPERATING MODE & APP CONFIGURATION
# ------------------------------------------------------------------------------
# In staging, use 'sandbox' to enforce server-authoritative payment checks
# and realistic validation while using test merchant tokens.
VITE_APP_MODE="sandbox"
VITE_OPERATING_MODE="sandbox"
VITE_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
PORT=3000

# ------------------------------------------------------------------------------
# 2. STAGING SUPABASE PROJECT CONFIGURATION (PUBLIC CLIENT VALUES)
# ------------------------------------------------------------------------------
# Project Ref: rkuzkwggijthbqwlwnps (ap-southeast-1)
VITE_SUPABASE_URL="https://rkuzkwggijthbqwlwnps.supabase.co"

# Obtain from: Supabase Dashboard -> aeropool-staging -> Settings -> API -> Project API keys -> anon (public)
VITE_SUPABASE_ANON_KEY="your-staging-anon-key-here"

# ------------------------------------------------------------------------------
# 3. STAGING SERVER-ONLY SECRETS (NEVER EXPOSE IN CLIENT BUNDLE)
# ------------------------------------------------------------------------------
# Obtain from: Supabase Dashboard -> aeropool-staging -> Settings -> API -> Project API keys -> service_role (secret)
# Used only by server webhook verification and administrative verification scripts.
SUPABASE_SERVICE_ROLE_KEY="your-staging-service-role-key-here"

# Direct PostgreSQL Connection String for Supabase CLI & Backend Migration Runners:
# Obtain from: Supabase Dashboard -> aeropool-staging -> Settings -> Database -> Connection string -> URI
DATABASE_URL="postgresql://postgres:[YOUR-STAGING-PASSWORD]@db.rkuzkwggijthbqwlwnps.supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (STAGING TEST MODE ONLY)
# ------------------------------------------------------------------------------
# Razorpay Test Mode Key ID (Public)
VITE_RAZORPAY_KEY_ID="rzp_test_YourTestKeyId12345"

# Razorpay Test Merchant Key Secret (Server Only)
RAZORPAY_KEY_SECRET="YourTestSecretKey12345"

# ------------------------------------------------------------------------------
# 5. MAPPING & TELEMETRY CONFIGURATION
# ------------------------------------------------------------------------------
# Google Maps API Key (Optional during billing review; corridor fallback active)
VITE_GOOGLE_MAPS_API_KEY=""

# Vector/Raster Map Tiles Provider
VITE_MAP_TILES_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"

# Flight Telemetry Provider Mode
VITE_FLIGHT_API_PROVIDER="csmia_schedule"

# ------------------------------------------------------------------------------
# 6. STAGING-ONLY TEMPORARY AUTHENTICATION FLAG (DEFERRED EMAIL VERIFICATION)
# ------------------------------------------------------------------------------
# Allows passenger and driver accounts to register and test instantly in staging
# without waiting for transactional emails or triggering Supabase bounce warnings.
#
# STRICT SECURITY BOUNDARIES:
# - Automatically ignored (fails closed) in production mode (VITE_OPERATING_MODE="production").
# - Does not bypass Supabase server-side rules: Requires "Confirm email" to be toggled OFF
#   in Supabase Dashboard (Auth -> Providers -> Email).
# - Driver safety intact: Drivers still require manual KYC admin approval before going online.
VITE_STAGING_SKIP_EMAIL_VERIFICATION="true"
STAGING_SKIP_EMAIL_VERIFICATION="true"
